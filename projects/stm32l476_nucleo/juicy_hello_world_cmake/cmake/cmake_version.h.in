#ifndef CMAKE_VERSION_H
#define CMAKE_VERSION_H

// clang-format off
#define PROJECT_VERSION_MAJOR     (@GIT_MAJOR@)
#define PROJECT_VERSION_MINOR     (@GIT_MINOR@)
#define PROJECT_VERSION_PATCH     (@GIT_PATCH@)
#define PROJECT_VERSION_DISTANCE  (@GIT_DISTANCE@)
#define PROJECT_VERSION \
    ((PROJECT_VERSION_MAJOR & 0xFF) << 24 | (PROJECT_VERSION_MINOR & 0xFF) << 16 | (PROJECT_VERSION_PATCH & 0xFF) << 8)
#define PROJECT_COMMIT (0x@GIT_COMMIT@)

#define PROJECT_VERSION_STR  "@GIT_SEMVER@"
#define PROJECT_COMMIT_STR   "@GIT_COMMIT@"
#define PROJECT_GIT_DESCRIBE "@GIT_DESCRIBE@"


#endif // CMAKE_VERSION_H
