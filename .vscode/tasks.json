{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run CI",
            "type": "shell",
            "linux": {
                "command": "docker run --rm -it -v ./:$PWD:z -w $PWD zig_and_c:0.16.0 sh ./ci/build-examples.sh",
            },
            "osx": {
                "command": "docker run --rm -it -v ./:$PWD:z -w $PWD zig_and_c:0.16.0 sh ./ci/build-examples.sh",
            },
            "windows": {
                "command": "docker run --rm -it -v $PWD:/workspace zig_and_c:0.16.0 sh ./ci/build-examples.sh",
            },
            "options": {
                "cwd": "${workspaceRoot}",
                "statusbar": {
                    "color": "#e166e6",
                    "label": "$(test-view-icon) Run CI",
                    "hide": false,
                }
            },
            "dependsOn": [
                "$(gear) Run CI"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
    ]
}
